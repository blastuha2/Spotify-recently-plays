# Partner mode: copy values from one successful recents/pathfinder request.
# Do not add the word Bearer.
SPOTIFY_PARTNER_TOKEN=
SPOTIFY_CLIENT_TOKEN=
SPOTIFY_APP_VERSION=

# Usually leave this empty. Set it only if Spotify changes persistedQuery.sha256Hash.
SPOTIFY_RECENTS_HASH=

# Official mode token (scope: user-read-recently-played).
SPOTIFY_TOKEN=
